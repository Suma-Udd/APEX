{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "APEX",
  "version": "1.4.1",
  "identifier": "com.apex.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "APEX",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#161618",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost wss://stream.binance.com:9443 wss://data-stream.binance.vision; frame-src https://www.tradingview.com https://*.tradingview.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/apex-backend"
    ],
    "category": "Finance",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "shortDescription": "Paper trading workspace"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUwM0YxREI0NTJERjMwQTgKUldTb01OOVN0QjAvVUFPRTRxQ2craHBjSFJPaWMzTHNZT2FKeHVXcDZpSW0za1lWbEpqSDhaTDUK",
      "endpoints": [
        "https://github.com/Suma-Udd/APEX/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
