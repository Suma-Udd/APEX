{
  "name": "apex",
  "private": true,
  "version": "1.3.3",
  "type": "module",
  "scripts": {
    "dev": "vite --port 1420 --strictPort",
    "dev:backend": "node scripts/dev-backend.mjs",
    "build": "tsc && vite build",
    "backend": "node scripts/build.mjs --backend",
    "build:app": "node scripts/build.mjs",
    "icons": "tauri icon app-icon.png && node -e \"for (const d of ['android','ios']) require('fs').rmSync('src-tauri/icons/'+d,{recursive:true,force:true})\"",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "set-version": "node scripts/set-version.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "lightweight-charts": "5.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  },
  "engines": {
    "node": ">=20 <25"
  }
}
